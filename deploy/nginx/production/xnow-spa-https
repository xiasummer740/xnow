server {
    listen 443 ssl http2;
    # 🏬 分站：免费子域名（t1./shop./…）与主站共用一个后端，
    #    由 siteMiddleware 按 Host 识别是哪一站。
    #    不加通配符的话，未匹配的 Host 会落到 default_server
    #    （那是另一个项目的 :8000），表现为"站长开了站，打开却是别人的网站"。
    #    自有域名不在这里：它由 siteDomain.js 自助生成独立 vhost（含证书申请）。
    server_name xnow.taikon.top *.xnow.taikon.top;

    ssl_certificate /etc/nginx/ssl/xnow.crt;
    ssl_certificate_key /etc/nginx/ssl/xnow.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 100m;

    # ══ Cloudflare 真实客户端 IP 还原 ══════════════════════════════════
    # 生产站挂在 Cloudflare 后面。不做这一步，$remote_addr 拿到的是 CF 边缘 IP，
    # 后果：按 IP 拉黑会误封整片用户、注册/登录 IP 全是机房地址、
    #       限流配额被整条边缘共享（等于限流形同虚设）。
    # set_real_ip_from 是白名单机制：只有【从 CF 机房来的连接】才采信它给的
    # 客户端 IP；别人直连源站伪造 CF-Connecting-IP 头不会生效。
    # 段列表来源 https://www.cloudflare.com/ips-v4 与 /ips-v6，取于 2026-09-20。
    # CF 这些网段极稳定；万一漏了新段，后果只是「那部分用户退回成 CF 机房 IP」，
    # 不会导致站点不可用。
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 构建产物带内容哈希：内容一变文件名就变，可以放心长缓存
    location /assets/ {
        root /var/www/xnow/client/dist;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        root /var/www/xnow/client/dist;
        # HTML 必须每次校验：否则发版后浏览器拿缓存里的旧页面，
        # 而旧页面指向旧代码包 —— 表现为「服务器上是新包，用户端毫无变化」。
        # no-cache 不是不缓存，是「用之前先问服务器有没有变」，没变回 304，变了回 200。
        add_header Cache-Control "no-cache";
        try_files $uri $uri.html $uri/ /index.html;
    }
}
